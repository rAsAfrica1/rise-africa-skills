{
  "course": "Soft Drinks Production",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to Soft Drinks",
      "lessons": [
        "History and Evolution of Soft Drinks",
        "Types of Soft Drinks: Carbonated, Non-Carbonated, and Functional",
