{
  "course": "Detergents Manufacturing",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to Detergents",
      "lessons": [
        "History and evolution of detergents",
        "Types of detergents: anionic, cationic, nonionic, amphoteric",
        "Key raw materials overview",
        "Market trends and applications",
        "Environmental and regulatory landscape",
        "Safety and handling basics"
      ]
    },
    {
      "number": 2,
      "title": "Surfactants: Chemistry and Function",
      "lessons": [
        "Structure and classification of surfactants",
        "Micelle formation and critical micelle concentration",
        "Hydrophilic-lipophilic balance (HLB) concept",
        "Anionic surfactants: LAS, AES, AS",
        "Nonionic surfactants: alcohol ethoxylates, alkylphenol ethoxylates",
        "Cationic and amphoteric surfactants"
      ]
    },
    {
      "number": 3,
      "title": "Builders and Additives",
      "lessons": [
        "Role of builders in detergents",
        "Inorganic builders: zeolites, carbonates, silicates",
        "Organic builders: citrates, polycarboxylates",
        "Bleaching agents and activators",
        "Enzymes: proteases, amylases, lipases",
        "Optical brighteners, fragrances, and dyes"
      ]
    },
    {
      "number": 4,
      "title": "Formulation Principles",
      "lessons": [
        "Balancing surfactant and builder ratios",
        "Liquid vs powder detergent formulations",
        "Concentrated and compact detergents",
        "pH control and buffering",
        "Viscosity and rheology modifiers",
        "Stability and compatibility testing"
      ]
    },
    {
      "number": 5,
      "title": "Raw Material Handling and Storage",
      "lessons": [
        "Receiving and inspection of raw materials",
        "Storage requirements for liquids and solids",
        "Safety data sheets (SDS) and hazard communication",
        "Inventory management and FIFO",
        "Prevention of contamination and degradation",
        "Waste handling and disposal"
      ]
    },
    {
      "number": 6,
      "title": "Mixing and Blending Operations",
      "lessons": [
        "Types of mixers: batch, continuous, inline",
        "Order of ingredient addition",
        "Mixing parameters: speed, time, temperature",
        "Homogenization and emulsification",
        "Monitoring and control of mixing",
        "Cleaning and changeover procedures"
      ]
    },
    {
      "number": 7,
      "title": "Heating and Cooling Processes",
      "lessons": [
        "Heat transfer fundamentals",
        "Jacketed vessels and heat exchangers",
        "Temperature control systems",
        "Cooling and crystallization",
        "Energy efficiency and insulation",
        "Safety in heating and cooling"
      ]
    },
    {
      "number": 8,
      "title": "Granulation and Powder Production",
      "lessons": [
        "Spray drying: principles and equipment",
        "Agglomeration and granulation techniques",
        "Fluid bed processing",
        "Particle size distribution and control",
        "Dust control and explosion prevention",
        "Quality parameters for powders"
      ]
    },
    {
      "number": 9,
      "title": "Liquid Detergent Production",
      "lessons": [
        "Blending of liquid ingredients",
        "Adjusting viscosity and clarity",
        "Filtration and purification",
        "Filling and packaging lines",
        "Preservation and microbial control",
        "Troubleshooting common issues"
      ]
    },
    {
      "number": 10,
      "title": "Quality Control and Assurance",
      "lessons": [
        "Sampling techniques and statistical process control",
        "Testing methods: titration, spectroscopy, chromatography",
        "Performance testing: foam height, detergency, soil removal",
        "Stability and shelf-life testing",
        "Documentation and batch records",
        "ISO and GMP standards"
      ]
    },
    {
      "number": 11,
      "title": "Packaging and Environmental Impact",
      "lessons": [
        "Packaging materials: plastics, paper, glass",
        "Sustainable packaging options",
        "Labeling and regulatory requirements",
        "Biodegradability and ecotoxicity",
        "Waste reduction and recycling",
        "Life cycle assessment"
      ]
    },
    {
      "number": 12,
      "title": "Plant Safety and Troubleshooting",
      "lessons": [
        "Hazard identification and risk assessment",
        "Personal protective equipment (PPE)",
        "Emergency response procedures",
        "Common process failures and solutions",
        "Preventive maintenance",
        "Case studies and best practices"
      ]
    }
  ]
}
