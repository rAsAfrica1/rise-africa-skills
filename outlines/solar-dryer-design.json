{
  "course": "Solar Dryer Design",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to Solar Drying",
      "lessons": [
        "Principles of Solar Drying",
        "Importance of Drying in Agriculture",
        "Overview of Solar Dryer Types",
        "Solar Drying vs. Traditional Drying",
        "Factors Affecting Drying Performance",
        "Applications of Solar Dryers"
      ]
    },
    {
      "number": 2,
      "title": "Solar Radiation and Energy Basics",
      "lessons": [
        "Solar Geometry and Sun Path",
