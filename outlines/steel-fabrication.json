{
  "course": "Steel Fabrication",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to Steel Fabrication",
      "lessons": [
        "Overview of Steel Fabrication Industry",
        "Steel Types and Properties",
        "Fabrication Processes Overview",
        "Safety in Steel Fabrication",
        "Reading Fabrication Drawings",
        "Career Paths and Opportunities"
      ]
    },
    {
      "number": 2,
      "title": "Steel Materials and Specifications",
      "lessons": [
        "Carbon Steel Grades and Applications",
        "Stainless Steel and Alloy Steels",
        "Steel Shapes and Sections",
        "Material Test Reports (MTRs)",
        "Steel Surface Preparation",
        "Material Handling and Storage"
      ]
    },
    {
      "number": 3,
      "title": "Layout and Marking",
      "lessons": [
        "Reading and Interpreting Blueprints",
        "Measuring Tools and Techniques",
        "Layout for Cutting and Drilling",
        "Marking with Soapstone and Scribe",
        "Templates and Jigs",
        "Tolerance and Allowances"
      ]
    },
    {
      "number": 4,
      "title": "Cutting Processes",
      "lessons": [
        "Oxy-Fuel Cutting",
        "Plasma Cutting",
        "Shearing and Guillotine Cutting",
        "Sawing and Abrasive Cutting",
        "Laser and Waterjet Cutting",
        "Cut Quality and Edge Preparation"
      ]
    },
    {
      "number": 5,
      "title": "Forming and Bending",
      "lessons": [
        "Press Brake Operations",
        "Roll Bending and Plate Rolling",
        "Pipe and Tube Bending",
        "Hot and Cold Forming",
        "Springback and Compensation",
        "Forming Defects and Remedies"
      ]
    },
    {
      "number": 6,
      "title": "Welding and Joining",
      "lessons": [
        "Shielded Metal Arc Welding (SMAW)",
        "Gas Metal Arc Welding (GMAW)",
        "Flux-Cored Arc Welding (FCAW)",
        "Gas Tungsten Arc Welding (GTAW)",
        "Weld Symbols and Joint Design",
        "Weld Inspection and Testing"
      ]
    },
    {
      "number": 7,
      "title": "Assembly and Fit-Up",
      "lessons": [
        "Fixture and Positioner Setup",
        "Tack Welding Techniques",
        "Alignment and Squaring",
        "Tolerance Control in Assembly",
        "Bolted Connections",
        "Riveting and Adhesive Bonding"
      ]
    },
    {
      "number": 8,
      "title": "Finishing and Surface Treatment",
      "lessons": [
        "Grinding and Surface Preparation",
        "Shot Blasting and Sandblasting",
        "Painting and Coating Systems",
        "Galvanizing and Metalizing",
        "Powder Coating",
        "Quality Inspection of Finishes"
      ]
    },
    {
      "number": 9,
      "title": "Quality Control and Inspection",
      "lessons": [
        "Visual Inspection Techniques",
        "Dimensional Inspection",
        "Non-Destructive Testing (NDT)",
        "Welding Procedure Specifications (WPS)",
        "Codes and Standards (AWS, ASTM)",
        "Documentation and Traceability"
      ]
    },
    {
      "number": 10,
      "title": "Fabrication of Structural Steel",
      "lessons": [
        "Beam and Column Fabrication",
        "Truss and Girder Fabrication",
        "Connection Design and Detailing",
        "Steel Decking and Joists",
        "Erection and Field Assembly",
        "Case Studies of Structural Projects"
      ]
    },
    {
      "number": 11,
      "title": "Advanced Fabrication Techniques",
      "lessons": [
        "CNC Machining and Automation",
        "Robotic Welding",
        "3D Printing in Steel Fabrication",
        "Laser Cutting and Engraving",
        "Modular Fabrication",
        "Lean Manufacturing in Fabrication"
      ]
    },
    {
      "number": 12,
      "title": "Project Management and Shop Operations",
      "lessons": [
        "Estimating and Costing",
        "Production Planning and Scheduling",
        "Inventory and Material Management",
        "Shop Safety and OSHA Regulations",
        "Team Leadership and Communication",
        "Capstone Fabrication Project"
      ]
    }
  ]
}
