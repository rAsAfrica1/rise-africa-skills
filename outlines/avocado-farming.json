{
  "course": "Avocado Farming",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to Avocado Farming",
      "lessons": [
        "History and Global Importance of Avocado",
        "Avocado Varieties and Cultivars",
        "Climate and Soil Requirements",
        "Overview of the Avocado Industry",
        "Economic Potential and Market Trends",
        "Basic Terminology in Avocado Farming"
      ]
    },
    {
      "number": 2,
      "title": "Site Selection and Soil Preparation",
      "lessons": [
        "Evaluating Site Suitability",
        "Soil Testing and Analysis",
        "Land Clearing and Preparation",
        "Drainage Management",
        "Soil pH Adjustment",
        "Terracing and Erosion Control"
      ]
    },
    {
      "number": 3,
      "title": "Avocado Propagation Techniques",
      "lessons": [
        "Seed Selection and Germination",
        "Grafting Methods: Whip and Cleft",
        "Budding Techniques",
        "Rootstock Selection",
        "Care of Nursery Seedlings",
        "Hardening Off and Transplanting"
      ]
    },
    {
      "number": 4,
      "title": "Orchard Establishment and Planting",
      "lessons": [
        "Spacing and Orchard Layout",
        "Digging and Preparing Planting Holes",
        "Transplanting Seedlings",
        "Pollination and Pollinizer Varieties",
        "Initial Training and Staking",
        "Irrigation Setup After Planting"
      ]
    },
    {
      "number": 5,
      "title": "Irrigation and Water Management",
      "lessons": [
        "Water Requirements of Avocado Trees",
        "Drip Irrigation Systems",
        "Sprinkler and Micro-Sprinkler Irrigation",
        "Scheduling Irrigation Based on Growth Stages",
        "Monitoring Soil Moisture",
        "Water Conservation Techniques"
      ]
    },
    {
      "number": 6,
      "title": "Nutrition and Fertilization",
      "lessons": [
        "Essential Nutrients for Avocado",
        "Soil and Leaf Tissue Testing",
        "Fertilizer Types and Application Methods",
        "Macronutrient Management (N, P, K)",
        "Micronutrient Management (Zn, B, Fe)",
        "Organic Fertilization Strategies"
      ]
    },
    {
      "number": 7,
      "title": "Pruning and Canopy Management",
      "lessons": [
        "Principles of Avocado Pruning",
        "Training Young Trees",
        "Pruning for Light Management",
        "Rejuvenation Pruning of Mature Trees",
        "Tools and Techniques for Pruning",
        "Disposal of Pruning Debris"
      ]
    },
    {
      "number": 8,
      "title": "Pest and Disease Management",
      "lessons": [
        "Common Insect Pests (e.g., Mites, Thrips)",
        "Major Diseases (e.g., Phytophthora Root Rot, Anthracnose)",
        "Integrated Pest Management (IPM) Strategies",
        "Biological Control Methods",
        "Safe Use of Pesticides",
        "Monitoring and Scouting Techniques"
      ]
    },
    {
      "number": 9,
      "title": "Harvesting and Post-Harvest Handling",
      "lessons": [
        "Determining Harvest Maturity",
        "Harvesting Tools and Techniques",
        "Field Handling and Collection",
        "Post-Harvest Cleaning and Grading",
        "Packaging and Storage",
        "Transportation to Market"
      ]
    },
    {
      "number": 10,
      "title": "Marketing and Value Addition",
      "lessons": [
        "Market Research and Analysis",
        "Direct Marketing vs. Wholesale",
        "Value-Added Products (Oil, Guacamole)",
        "Branding and Certification (Organic, Fair Trade)",
        "Export Requirements and Regulations",
        "Building Customer Relationships"
      ]
    },
    {
      "number": 11,
      "title": "Sustainable and Organic Avocado Farming",
      "lessons": [
        "Principles of Sustainable Agriculture",
        "Organic Certification Process",
        "Composting and Mulching",
        "Cover Cropping and Green Manures",
        "Biodiversity Enhancement",
        "Reducing Carbon Footprint"
      ]
    },
    {
      "number": 12,
      "title": "Farm Business Management and Economics",
      "lessons": [
        "Cost of Production and Budgeting",
        "Record Keeping and Accounting",
        "Labor Management",
        "Risk Management and Insurance",
        "Financing and Grants",
        "Developing a Business Plan"
      ]
    }
  ]
}
