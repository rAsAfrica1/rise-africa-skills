{
  "course": "EV Motorbike Assembly",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to EV Motorbike Technology",
      "lessons": [
        "Overview of Electric Motorbike Components",
        "Understanding Electric vs. Internal Combustion Engines",
        "Safety Protocols for High-Voltage Systems",
        "Tools and Equipment for EV Assembly",
        "Reading Electrical Schematics and Diagrams",
        "Workplace Organization and Assembly Flow"
      ]
    },
    {
      "number": 2,
      "title": "Frame and Chassis Preparation",
      "lessons": [
        "Inspecting and Cleaning the Frame",
        "Mounting the Frame on Assembly Jig",
        "Installing Steering Head Bearings",
        "Attaching Swingarm and Rear Suspension",
        "Front Fork Installation and Alignment",
        "Torque Specifications for Chassis Fasteners"
      ]
    },
    {
      "number": 3,
      "title": "Battery Pack Installation",
      "lessons": [
        "Battery Pack Unboxing and Inspection",
        "Mounting Battery Enclosure to Frame",
        "Connecting High-Voltage Cables",
        "Installing Battery Management System (BMS)",
        "Securing Battery with Vibration Dampeners",
        "Testing Battery Voltage and Insulation"
      ]
    },
    {
      "number": 4,
      "title": "Electric Motor and Controller Mounting",
      "lessons": [
        "Motor Mounting Bracket Installation",
        "Aligning and Torquing Motor Bolts",
        "Controller Placement and Heat Sink Setup",
        "Wiring Motor Phase Cables",
        "Connecting Controller to Battery and Motor",
        "Initial Controller Parameter Setup"
      ]
    },
    {
      "number": 5,
      "title": "Drivetrain and Transmission Assembly",
      "lessons": [
        "Installing Motor Sprocket",
        "Mounting Rear Wheel Sprocket",
        "Chain or Belt Tensioning",
        "Aligning Drivetrain Components",
        "Lubricating Chain/Belt",
        "Checking Drivetrain Free Play"
      ]
    },
    {
      "number": 6,
      "title": "Brake System Installation",
      "lessons": [
        "Mounting Front Brake Caliper and Rotor",
        "Installing Rear Brake Caliper and Rotor",
        "Connecting Brake Lines and Bleeding",
        "Adjusting Brake Lever Free Play",
        "Testing Brake Function and Safety",
        "Parking Brake Integration (if applicable)"
      ]
    },
    {
      "number": 7,
      "title": "Wheel and Tire Assembly",
      "lessons": [
        "Tire Mounting on Rim",
        "Balancing Wheels",
        "Installing Wheel Bearings",
        "Mounting Front Wheel to Forks",
        "Mounting Rear Wheel to Swingarm",
        "Checking Wheel Alignment and Spacers"
      ]
    },
    {
      "number": 8,
      "title": "Electrical Wiring and Lighting",
      "lessons": [
        "Routing Main Wiring Harness",
        "Connecting Headlight and Taillight",
        "Installing Turn Signals and Horn",
        "Wiring Dashboard and Display",
        "Connecting 12V Accessory System",
        "Testing Electrical Continuity"
      ]
    },
    {
      "number": 9,
      "title": "Throttle and Control Systems",
      "lessons": [
        "Installing Throttle Assembly",
        "Connecting Throttle to Controller",
        "Mounting Handlebar Controls",
        "Adjusting Throttle Response",
        "Installing Side Stand Sensor",
        "Testing Control Inputs"
      ]
    },
    {
      "number": 10,
      "title": "Bodywork and Fairings",
      "lessons": [
        "Installing Front Fairing and Windscreen",
        "Mounting Side Panels and Tank Cover",
        "Attaching Rear Fender and Tail Section",
        "Securing Seat and Cushions",
        "Installing Foot Pegs and Guards",
        "Final Bodywork Alignment"
      ]
    },
    {
      "number": 11,
      "title": "Testing and Quality Control",
      "lessons": [
        "Pre-Power Safety Checks",
        "Low-Voltage System Test",
        "High-Voltage System Activation",
        "Motor Spin and Throttle Response Test",
        "Brake and Light Function Test",
        "Road Test Simulation and Data Logging"
      ]
    },
    {
      "number": 12,
      "title": "Final Inspection and Handover",
      "lessons": [
        "Torque Check of Critical Fasteners",
        "Fluid and Lubricant Top-Off",
        "Software Update and Calibration",
        "Cleaning and Detailing",
        "Documentation and Warranty Registration",
        "Customer Handover and Basic Training"
      ]
    }
  ]
}
