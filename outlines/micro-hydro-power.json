{
  "course": "Micro-Hydro Power",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to Micro-Hydro Power",
      "lessons": [
        "Overview of Micro-Hydro Systems",
        "History and Global Applications",
        "Advantages and Limitations",
        "Components of a Micro-Hydro Plant",
        "Site Assessment Basics",
        "Safety and Environmental Considerations"
      ]
    },
    {
      "number": 2,
      "title": "Hydrology and Water Resource Assessment",
      "lessons": [
        "Measuring Stream Flow: Weir and Salt Dilution Methods",
        "Using Flow Meters and Current Meters",
        "Estimating Flow Duration Curves",
        "Rainfall-Runoff Analysis for Micro-Hydro",
        "Seasonal Flow Variability and Design Flow",
        "Water Rights and Permitting"
      ]
    },
    {
      "number": 3,
      "title": "Head Measurement and Site Surveying",
      "lessons": [
        "Using Surveying Levels and Theodolites",
        "Pressure Gauge and Altimeter Methods",
        "GPS and GIS for Head Measurement",
        "Plotting the Course of the Penstock",
        "Determining Gross and Net Head",
        "Recording and Documenting Survey Data"
      ]
    },
    {
      "number": 4,
      "title": "Civil Works: Intake, Canal, and Forebay",
      "lessons": [
        "Designing a Diversion Weir and Intake",
        "Construction of Headrace Canal",
        "Sediment Management: Gravel Trap and Settling Basin",
        "Forebay Tank Design and Construction",
        "Spillways and Overflow Structures",
        "Maintenance of Civil Structures"
      ]
    },
    {
      "number": 5,
      "title": "Penstock Design and Installation",
      "lessons": [
        "Material Selection: PVC, HDPE, Steel",
        "Calculating Penstock Diameter and Wall Thickness",
        "Head Loss Calculations and Optimization",
        "Anchor Blocks and Expansion Joints",
        "Pipe Jointing and Leak Testing",
        "Penstock Maintenance and Repair"
      ]
    },
    {
      "number": 6,
      "title": "Turbines for Micro-Hydro",
      "lessons": [
