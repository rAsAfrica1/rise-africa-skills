        "Selecting a Turbine Based on Head and Flow",
        "Turbine Efficiency and Performance Curves",
        "Design and Fabrication of Pelton Wheels",
        "Cross-Flow Turbine Construction",
        "Turbine Installation and Alignment"
      ]
    },
    {
      "number": 7,
      "title": "Generators and Electrical Systems",
      "lessons": [
        "AC Generators: Synchronous and Induction",
        "DC Generators and Permanent Magnet Alternators",
        "Voltage and Frequency Control",
        "Wiring and Switchgear for Micro-Hydro",
        "Battery Charging Systems",
        "Earthing and Lightning Protection"
      ]
    },
    {
      "number": 8,
      "title": "Mechanical Transmission and Speed Control",
      "lessons": [
        "Direct Coupling vs. Belt Drive",
        "Designing Pulley and Belt Systems",
        "Electronic Load Controllers",
        "Governor Mechanisms for Speed Regulation",
        "Ballast Load Management",
        "Troubleshooting Mechanical Drive Issues"
      ]
    },
    {
      "number": 9,
      "title": "Electrical Load Assessment and Distribution",
      "lessons": [
        "Estimating Community Electricity Demand",
        "Load Factor and Diversity Factor",
        "Designing Distribution Networks",
        "Metering and Tariff Structures",
        "Wiring Houses and Productive Uses",
        "Load Management Strategies"
      ]
    },
    {
      "number": 10,
      "title": "System Integration and Testing",
      "lessons": [
        "Assembling the Complete System",
        "Commissioning Procedures",
        "Performance Testing and Efficiency Measurement",
        "Troubleshooting Common Operational Issues",
        "Automation and Remote Monitoring",
        "Documentation and As-Built Drawings"
      ]
    },
    {
      "number": 11,
      "title": "Operation, Maintenance, and Troubleshooting",
      "lessons": [
        "Routine Maintenance Schedule",
        "Cleaning Intake and Sediment Basins",
        "Turbine and Generator Maintenance",
        "Electrical System Inspection",
        "Diagnosing and Fixing Common Faults",
        "Spare Parts Management"
      ]
    },
    {
      "number": 12,
      "title": "Project Development and Community Management",
      "lessons": [
        "Feasibility Study and Cost Estimation",
        "Financing Models and Subsidies",
        "Community Engagement and Training",
        "Establishing a Management Committee",
        "Environmental Impact Assessment",
        "Case Studies of Successful Micro-Hydro Projects"
      ]
    }
