{
  "course": "Project Management",
  "modules": [
    {
      "number": 1,
      "title": "Foundations of Project Management",
      "lessons": [
        "Defining a Project and Its Constraints",
        "Project vs. Product vs. Program Management",
        "The Role of the Project Manager",
        "Project Life Cycle Phases",
        "Key Stakeholders and Their Expectations",
        "Introduction to PMBOK and Agile Frameworks"
      ]
    },
    {
      "number": 2,
      "title": "Project Initiation and Chartering",
      "lessons": [
        "Developing a Project Charter",
        "Identifying Business Needs and Benefits",
        "Conducting Stakeholder Analysis",
        "Defining High-Level Scope and Deliverables",
        "Assembling the Project Team",
        "Obtaining Formal Project Approval"
      ]
    },
    {
      "number": 3,
      "title": "Scope Planning and Management",
      "lessons": [
        "Creating a Scope Statement",
        "Developing a Work Breakdown Structure (WBS)",
        "Defining Work Packages and Activities",
        "Scope Verification and Validation",
        "Managing Scope Creep",
        "Change Control Procedures"
      ]
    },
    {
      "number": 4,
      "title": "Schedule Development and Control",
      "lessons": [
        "Activity Sequencing and Dependencies",
        "Estimating Activity Durations",
        "Critical Path Method (CPM)",
        "Gantt Charts and Milestone Tracking",
        "Schedule Compression Techniques",
        "Monitoring and Updating the Schedule"
      ]
    },
    {
      "number": 5,
      "title": "Cost Estimation and Budgeting",
      "lessons": [
        "Cost Estimation Methods (Analogous, Parametric, Bottom-Up)",
        "Developing a Project Budget",
        "Contingency and Management Reserves",
        "Cost Baseline and Funding Requirements",
        "Earned Value Management (EVM) Basics",
        "Cost Control and Forecasting"
      ]
    },
    {
      "number": 6,
      "title": "Quality Management",
      "lessons": [
        "Quality Planning and Standards",
        "Cost of Quality",
        "Quality Assurance vs. Quality Control",
        "Tools for Quality Control (Pareto, Fishbone, Control Charts)",
        "Continuous Improvement in Projects",
        "Validating Deliverables and Acceptance Criteria"
      ]
    },
    {
      "number": 7,
      "title": "Resource and Team Management",
      "lessons": [
        "Resource Planning and Allocation",
        "Developing a Responsibility Assignment Matrix (RAM)",
        "Team Development Stages (Tuckman Model)",
        "Motivation and Leadership Styles",
        "Conflict Resolution in Teams",
        "Virtual Team Management"
      ]
    },
    {
      "number": 8,
      "title": "Communication and Stakeholder Engagement",
      "lessons": [
        "Communication Planning",
        "Information Distribution Methods",
        "Performance Reporting",
        "Managing Stakeholder Expectations",
        "Effective Meeting Facilitation",
        "Negotiation and Influencing Skills"
      ]
    },
    {
      "number": 9,
      "title": "Risk Management",
      "lessons": [
        "Risk Identification Techniques",
        "Qualitative Risk Analysis",
        "Quantitative Risk Analysis",
        "Risk Response Planning (Avoid, Mitigate, Transfer, Accept)",
        "Risk Monitoring and Control",
        "Issue Management and Contingency Planning"
      ]
    },
    {
      "number": 10,
      "title": "Procurement and Vendor Management",
      "lessons": [
        "Procurement Planning",
        "Contract Types (Fixed-Price, Cost-Reimbursable, T&M)",
        "Selecting Vendors and Bidders",
        "Administering Contracts",
        "Vendor Performance Monitoring",
        "Closing Procurements"
      ]
    },
    {
      "number": 11,
      "title": "Agile and Hybrid Project Management",
      "lessons": [
        "Agile Manifesto and Principles",
        "Scrum Framework: Roles, Events, Artifacts",
        "Kanban and Lean Practices",
        "Hybrid Approaches (Agile + Waterfall)",
        "Scaling Agile (SAFe, LeSS)",
        "Agile Metrics and Burndown Charts"
      ]
    },
    {
      "number": 12,
      "title": "Project Closure and Lessons Learned",
      "lessons": [
        "Closing Project Phases and Contracts",
        "Final Product Transition and Handover",
        "Post-Implementation Review",
        "Documenting Lessons Learned",
        "Releasing Project Resources",
        "Celebrating Success and Team Recognition"
      ]
    }
  ]
}
