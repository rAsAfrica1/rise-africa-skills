{
  "course": "AI Fundamentals",
  "modules": [
    {
      "number": 1,
      "title": "Introduction to Artificial Intelligence",
      "lessons": [
        "What is AI? Definitions and Scope",
        "History of AI: From Turing to Deep Learning",
        "AI vs. Machine Learning vs. Deep Learning",
        "Types of AI: Narrow, General, and Superintelligence",
        "Real-World Applications of AI",
        "Ethical Considerations in AI"
      ]
    },
    {
      "number": 2,
      "title": "Mathematical Foundations for AI",
      "lessons": [
        "Linear Algebra: Vectors and Matrices",
        "Matrix Operations and Transformations",
        "Probability Basics for AI",
        "Statistics: Descriptive and Inferential",
        "Calculus: Derivatives and Gradients",
        "Optimization: Gradient Descent"
      ]
    },
    {
      "number": 3,
      "title": "Python for AI",
      "lessons": [
        "Python Basics: Variables and Data Types",
        "Control Flow and Functions",
        "Data Structures: Lists, Tuples, Dictionaries",
        "NumPy for Numerical Computing",
        "Pandas for Data Manipulation",
        "Matplotlib and Seaborn for Visualization"
      ]
    },
    {
      "number": 4,
      "title": "Data Preprocessing and Feature Engineering",
      "lessons": [
        "Data Cleaning: Handling Missing Values",
        "Data Normalization and Standardization",
        "Categorical Encoding Techniques",
        "Feature Scaling and Transformation",
        "Feature Selection Methods",
        "Dimensionality Reduction with PCA"
      ]
    },
    {
      "number": 5,
      "title": "Supervised Learning: Regression",
      "lessons": [
        "Simple Linear Regression",
        "Multiple Linear Regression",
        "Polynomial Regression",
        "Regularization: Ridge and Lasso",
        "Model Evaluation Metrics for Regression",
        "Cross-Validation Techniques"
      ]
    },
    {
      "number": 6,
      "title": "Supervised Learning: Classification",
      "lessons": [
        "Logistic Regression",
        "K-Nearest Neighbors",
        "Decision Trees",
        "Support Vector Machines",
        "Naive Bayes Classifier",
        "Evaluation Metrics: Accuracy, Precision, Recall, F1"
      ]
    },
    {
      "number": 7,
      "title": "Unsupervised Learning",
      "lessons": [
        "K-Means Clustering",
        "Hierarchical Clustering",
        "DBSCAN Clustering",
        "Principal Component Analysis (PCA)",
        "t-SNE for Visualization",
        "Association Rules: Apriori Algorithm"
      ]
    },
    {
      "number": 8,
      "title": "Neural Networks and Deep Learning",
      "lessons": [
        "Perceptron and Multilayer Perceptrons",
        "Activation Functions",
        "Backpropagation Algorithm",
        "Gradient Descent Variants",
        "Regularization in Neural Networks",
        "Introduction to TensorFlow and Keras"
      ]
    },
    {
      "number": 9,
      "title": "Convolutional Neural Networks (CNNs)",
      "lessons": [
        "Convolutional Layers and Filters",
        "Pooling Layers",
        "CNN Architectures: LeNet, AlexNet, VGG",
        "Image Augmentation Techniques",
        "Transfer Learning",
        "Object Detection with YOLO"
      ]
    },
    {
      "number": 10,
      "title": "Recurrent Neural Networks (RNNs) and NLP",
      "lessons": [
        "RNN Basics and Vanishing Gradient",
        "LSTM and GRU Cells",
        "Word Embeddings: Word2Vec and GloVe",
        "Sequence-to-Sequence Models",
        "Attention Mechanism",
        "Introduction to Transformers"
      ]
    },
    {
      "number": 11,
      "title": "Reinforcement Learning",
      "lessons": [
        "Markov Decision Processes",
        "Q-Learning",
        "Deep Q-Networks (DQN)",
        "Policy Gradient Methods",
        "Actor-Critic Methods",
        "Applications in Games and Robotics"
      ]
    },
    {
      "number": 12,
      "title": "AI Ethics, Fairness, and Future Trends",
      "lessons": [
        "Bias and Fairness in AI",
        "Privacy and Security in AI",
        "Explainable AI (XAI)",
        "AI Regulations and Governance",
        "Generative AI and Large Language Models",
        "Future of AI: Trends and Challenges"
      ]
    }
  ]
}
